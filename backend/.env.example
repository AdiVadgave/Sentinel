# ============================================================
# Sentinel PoC — Backend environment
# Copy this file to ".env" and fill in your Azure AI Foundry details.
#
# Your model is a CLAUDE model deployed in Azure AI Foundry, reached through the
# native Anthropic Messages API (the AnthropicFoundry client). The endpoint host
# ends in ".services.ai.azure.com" and the path is "/anthropic".
# ============================================================

# Full Foundry endpoint, including the /anthropic path. The resource name is
# parsed from this automatically (the subdomain before .services.ai.azure.com).
# Example: https://my-resource.services.ai.azure.com/anthropic
AZURE_OPENAI_ENDPOINT=

# Optional: set the Foundry resource name explicitly instead of parsing it from
# the endpoint (e.g. "my-resource"). Leave blank to auto-derive from the endpoint.
AZURE_FOUNDRY_RESOURCE=

# The API key for the Foundry resource (Azure AI Foundry > Keys and Endpoint).
AZURE_OPENAI_API_KEY=

# The model / deployment name in Foundry (NOT a model family alias).
# e.g. "claude-sonnet-4-6"  (your GPT-4o deployment name would go here if using GPT)
AZURE_OPENAI_DEPLOYMENT=claude-sonnet-4-6

# Kept for compatibility; ignored by the Anthropic Foundry client.
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- App config ---
# Comma-separated list of allowed CORS origins (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to "false" to force scripted/offline demo mode even if credentials exist
# (useful for a guaranteed-stable rehearsal with no network).
USE_AZURE=true
